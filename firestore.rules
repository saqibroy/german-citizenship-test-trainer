rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // User can read and write their own profile
      allow read, write: if isOwner(userId);
      
      // User progress subcollection
      match /progress/{questionId} {
        allow read, write: if isOwner(userId);
      }
      
      // Quiz history subcollection
      match /quizHistory/{quizId} {
        allow read, write: if isOwner(userId);
      }
      
      // Vocabulary progress subcollection
      match /vocabProgress/{wordId} {
        allow read, write: if isOwner(userId);
      }
      
      // Usage tracking subcollection
      match /usage/{date} {
        allow read, write: if isOwner(userId);
      }
      
      // Settings subcollection
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Admin-only collections (if needed)
    match /admin/{document=**} {
      allow read, write: if request.auth != null && 
        request.auth.token.admin == true;
    }
    
    // Public content (if any)
    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
